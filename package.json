{
  "name": "atriveo-reel",
  "version": "0.1.0",
  "private": true,
  "description": "Atriveo Reel — paste two videos, pick two moments, get a vertical comparison reel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atishay-kasliwal/atriveo-reel.git"
  },
  "homepage": "https://reels.atriveo.com",
  "scripts": {
    "dev": "tsx scripts/next-with-env.ts dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm:dev\" \"npm:dev:worker\"",
    "build": "next build",
    "start": "tsx scripts/next-with-env.ts start",
    "worker": "tsx src/worker/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.230",
    "@remotion/cli": "^4.0.230",
    "@remotion/renderer": "^4.0.230",
    "better-sqlite3": "^11.7.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.230",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
