# ---- Web app ----
# Port the Next.js server listens on. Cloudflare Tunnel points here.
APP_PORT=3000

# Shared password for private access. CHANGE THIS.
# Leave empty to disable auth entirely (not recommended if tunnel is public).
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a login stays valid, in hours.
SESSION_TTL_HOURS=720

# ---- Storage ----
# Root of all persisted data: sources, renders, projects, temp.
DATA_DIR=~/reels-data

# ---- Rendering ----
# Number of renders allowed to run at once. Keep at 1 on a Mac Mini.
MAX_CONCURRENT_RENDERS=1

# h264_videotoolbox = Apple hardware encoder (fast, recommended on Mac).
# libx264 = software encoder (slower, slightly better compression).
VIDEO_ENCODER=h264_videotoolbox

# Output quality. For videotoolbox this is a bitrate like "8M".
# For libx264 this is a CRF value like "20".
VIDEO_QUALITY=8M

# Refuse to start a render if free disk space is below this many MB.
MIN_FREE_DISK_MB=5000

# ---- Media fetching ----
# Path to yt-dlp. Leave as "yt-dlp" if it is on PATH.
YTDLP_PATH=yt-dlp

# Max source video duration to download, in seconds. Guards against
# accidentally pulling a 3-hour video for a 10-second clip.
MAX_SOURCE_DURATION_SECONDS=14400

# Max upload size in MB.
MAX_UPLOAD_MB=2048

# ---- Cleanup ----
# Delete temp working files after a successful render.
CLEANUP_TEMP_ON_SUCCESS=true

# Retention for downloaded source videos, in days. 0 = keep forever.
SOURCE_RETENTION_DAYS=7

# Retention for finished renders, in days. 0 = keep forever (default:
# never auto-delete a user's finished reel).
RENDER_RETENTION_DAYS=0
